# Semgrep (pr.yml, sast). A .semgrepignore replaces semgrep's default exclusions, so they are listed here to keep
# the scan scope as before; git-ignored files stay out too.
:include .gitignore
node_modules/
build/
dist/
vendor/
.env/
.venv/
.tox/
*.min.js
.npm/
.yarn/
test/
tests/
*_test.go
.semgrep
.semgrep_logs/

