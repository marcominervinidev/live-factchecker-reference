<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd user agent for the limit watcher (task #54). install.sh fills in the three
     placeholders (python path, repo dir, state dir) and copies the result to ~/Library/LaunchAgents/. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lfc.limit-waechter</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-I</string>
    <string>__REPO_DIR__/tools/limit-waechter/watch.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LIMIT_WAECHTER_HOME</key>
    <string>__LW_HOME__</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LW_HOME__/watch.log</string>
  <key>StandardErrorPath</key>
  <string>__LW_HOME__/watch.err.log</string>
</dict>
</plist>
