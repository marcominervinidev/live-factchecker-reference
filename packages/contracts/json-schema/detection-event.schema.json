{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "type": {
          "type": "string",
          "const": "claim"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "claim": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "id": {
              "type": "string",
              "pattern": "^c-[0-9]{2,15}$"
            },
            "turnId": {
              "type": "string",
              "pattern": "^t-[0-9]{3,15}$"
            },
            "source": {
              "type": "string",
              "enum": [
                "claim_extractor",
                "resolver"
              ]
            },
            "speaker": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "speakerLabel": {
              "type": "string",
              "pattern": "^[A-Z]+$"
            },
            "sentence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "verbatim": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "segmentIds": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^s-[0-9]{1,15}$"
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "zahl",
                "ereignis",
                "zitat",
                "ursache"
              ]
            },
            "checkworthiness": {
              "type": "string",
              "enum": [
                "hoch",
                "niedrig"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "tatsache",
                "widerspruch",
                "zustimmung",
                "meinung_mit_kern"
              ]
            },
            "refersTo": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^c-[0-9]{2,15}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "start": {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            },
            "end": {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            },
            "lastWordEnd": {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            },
            "emittedAt": {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            }
          },
          "required": [
            "schemaVersion",
            "id",
            "turnId",
            "source",
            "speaker",
            "speakerLabel",
            "sentence",
            "verbatim",
            "segmentIds",
            "type",
            "checkworthiness",
            "kind",
            "refersTo",
            "start",
            "end",
            "lastWordEnd",
            "emittedAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "sessionId",
        "claim"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "type": {
          "type": "string",
          "const": "topic"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "topic": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "tickAt": {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            },
            "current": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "new": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tag": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "parent": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "tag",
                  "parent"
                ],
                "additionalProperties": false
              }
            },
            "returned": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "ended": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          },
          "required": [
            "schemaVersion",
            "tickAt",
            "current",
            "new",
            "returned",
            "ended"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "sessionId",
        "topic"
      ],
      "additionalProperties": false
    }
  ]
}
