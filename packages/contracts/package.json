{
  "name": "@lfc/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The schemas every seam speaks, in Zod; JSON Schema generated from them for readers without Zod.",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/fixtures.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "vitest run",
    "test:mutation": "stryker run",
    "generate:json-schema": "node scripts/generate-json-schema.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
